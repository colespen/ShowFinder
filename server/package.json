{
  "name": "server",
  "version": "1.0.0",
  "description": "ShowFinder-API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/index.ts",
    "test": "node --test --env-file-if-exists=.env 'src/**/*.test.ts'"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "morgan": "^1.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}
